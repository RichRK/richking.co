---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  title: string;
  count: number;
  cover: ImageMetadata;
}

const { href, title, count, cover } = Astro.props;
---

<a href={href} class="album">
  {
    /* The circular cover. Blurs on hover, which is why the labels below are
      siblings rather than children — the original split them for the same
      reason, so the blur filter would not inherit onto the text. */
  }
  <span class="album__disc">
    <Image
      src={cover}
      alt=""
      widths={[300, 600, 900]}
      sizes="(max-width: 48rem) 74vw, 37vw"
      loading="lazy"
      decoding="async"
      class="album__image"
    />
  </span>

  <span class="album__title"><h3>{title}</h3></span>
  <span class="album__count">
    <h4>{count} {count === 1 ? 'photo' : 'photos'}</h4>
  </span>
</a>

<style>
  /*
   * Ported from the `.albumMain` / `.albumContainer` / `.albumTitleOverlay` /
   * `.photoCount` block of styles.css. The cover used to be assigned by a
   * per-album `a[href*="…"] { background-image: … }` rule in the stylesheet —
   * eight of them, hand-written. It is a real <img> passed as a prop now, so
   * adding an album no longer means editing CSS.
   */
  .album {
    position: relative;
    display: inline-block;
    width: 37%;
    margin: 0 3% 5%;
    border: 0.8vh solid rgba(255, 255, 255, 0.9);
    border-radius: 50%;
    vertical-align: top;
  }

  .album__disc {
    display: block;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    transition: filter 0.2s ease-out;
  }

  .album__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .album:hover .album__disc,
  .album:focus-visible .album__disc {
    filter: blur(5px);
  }

  /* Always-visible white label, sitting low inside the circle. */
  .album__title {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 21%;
    text-align: center;
    z-index: 100;
    transition: transform 0.2s ease;
  }

  .album__title h3 {
    display: inline-block;
    background: rgba(255, 255, 255, 0.95);
    /* Lifts the title clear of whatever photograph is behind it. */
    box-shadow: 0 0 15px 2px rgba(0, 0, 0, 0.4);
    padding: 0.65vw 1.3vw;
    color: var(--paper);
    font-size: 1.4vw;
    font-weight: bold;
    font-family: var(--font-ui);
    text-transform: none;
  }

  .album:hover .album__title,
  .album:focus-visible .album__title {
    transform: translateY(-140%) scale(1.5);
  }

  /* Photo count, revealed on hover beneath the risen title. */
  .album__count {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 21%;
    text-align: center;
    opacity: 0;
    z-index: 100;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .album__count h4 {
    display: inline-block;
    font-family: var(--font-display);
    background: rgba(0, 0, 0, 0.9);
    color: #999;
    font-size: 2vh;
    padding: 0.8vh 1vh;
    font-style: italic;
  }

  .album:hover .album__count,
  .album:focus-visible .album__count {
    opacity: 1;
    transform: translateY(80%);
  }

  @media (max-width: 48rem) {
    /* One circle per row, labels always shown — there is no hover to rely on. */
    .album {
      width: 74%;
      margin: 0 auto 8%;
      display: block;
    }

    .album__title h3 {
      font-size: 15px;
      padding: 6px 12px;
    }

    .album__count {
      opacity: 1;
      transform: translateY(150%);
    }

    .album__count h4 {
      font-size: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .album__disc,
    .album__title,
    .album__count {
      transition: none;
    }
  }
</style>
