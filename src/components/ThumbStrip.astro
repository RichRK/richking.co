---
import { Image } from 'astro:assets';
import type { Album } from '../utils/albums';

interface Props {
  album: Album;
}

const { album } = Astro.props;

/*
 * The 2014 site painted this strip from www/css/thumbnails.css — 1,226 lines of
 * generated `html[data-album=…] a:nth-child(N) { background: url(…) }` rules,
 * one per photo, plus a separate 174-file thumbnail directory that had to be
 * regenerated by hand. Both are gone: these are real <img> elements built from
 * the same sources as the full-size photos.
 *
 * The one thing worth keeping from that stylesheet was its hand-tuned
 * `background-position` values — the only record of each thumbnail's intended
 * focal point. They survive as `object-position`.
 */
const THUMB_WIDTHS = [70, 140, 210];
---

<nav class="thumbstrip" aria-label="Photos in this album">
  <a href="#photo-0" class="thumbstrip__item thumbstrip__item--intro is-current">
    <span class="visually-hidden">Album summary</span>
    <span class="thumbstrip__marker" aria-hidden="true"></span>
  </a>

  {
    album.photos.map((photo, index) => (
      <a href={`#photo-${index + 1}`} class="thumbstrip__item">
        <Image
          src={photo.src}
          alt=""
          widths={THUMB_WIDTHS}
          sizes="9vh"
          loading="lazy"
          decoding="async"
          class="thumbstrip__image"
          style={`object-position: ${photo.thumbPosition};`}
        />
        <span class="thumbstrip__overlay" aria-hidden="true">
          <span class="thumbstrip__number">{index + 1}</span>
        </span>
        <span class="visually-hidden">Photo {index + 1}</span>
      </a>
    ))
  }
</nav>

<style>
  .thumbstrip {
    position: fixed;
    z-index: 50;
    bottom: 2vh;
    left: 50%;
    transform: translate(-50%, 0);
    width: 90%;
    font-size: 0;
    text-align: center;
    white-space: nowrap;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    scroll-behavior: smooth;
  }

  .thumbstrip::-webkit-scrollbar {
    display: none;
  }

  .thumbstrip__item {
    display: inline-block;
    position: relative;
    width: 7vh;
    aspect-ratio: 1;
    transition: width var(--transition);
  }

  .thumbstrip__item:hover {
    width: 9vh;
  }

  .thumbstrip__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The dark square that opens the strip and jumps back to the summary card. */
  .thumbstrip__item--intro {
    background: rgba(0, 0, 0, 0.9);
    box-shadow: inset 0 0 20px 3px rgba(255, 255, 255, 0.15);
  }

  .thumbstrip__marker {
    width: 2.5vh;
    height: 1.25vh;
    background: #999;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    transition: all var(--transition);
  }

  .thumbstrip__item--intro:hover .thumbstrip__marker {
    width: 3.4vh;
    height: 1.6vh;
  }

  /* White wash with the photo number, shown only for the current photo. */
  .thumbstrip__overlay {
    position: absolute;
    inset: 0;
    background: var(--ink);
    visibility: hidden;
    box-shadow: inset 0 0 20px 3px rgba(0, 0, 0, 0.9);
  }

  .thumbstrip__item.is-current .thumbstrip__overlay {
    visibility: visible;
  }

  .thumbstrip__number {
    position: absolute;
    z-index: 60;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--font-display);
    font-size: 3vh;
    color: var(--paper);
  }

  .thumbstrip__item:hover .thumbstrip__number {
    font-size: 4vh;
  }

  /* The stacked layout scrolls the photos themselves — no strip needed. */
  @media (max-width: 48rem) {
    .thumbstrip {
      display: none;
    }
  }
</style>
