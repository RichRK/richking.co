---
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import AlbumTile from '../../components/AlbumTile.astro';

const modules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/photos/**/*.{jpg,jpeg,JPG,JPEG}',
  { eager: true },
);

const entries = await getCollection('albums');

/*
 * Albums with an explicit `order` in their album.yaml keep the hand-picked
 * sequence the 2014 site hardcoded into photo.html. Anything dropped in without
 * one sorts after those, newest capture first, so a new album appears without
 * anyone having to renumber the others.
 */
const albums = entries
  .map((entry) => entry.data)
  .sort((a, b) => {
    if (a.order !== undefined && b.order !== undefined) return a.order - b.order;
    if (a.order !== undefined) return -1;
    if (b.order !== undefined) return 1;

    const dateA = a.photos[0]?.exif.capturedAt?.getTime() ?? 0;
    const dateB = b.photos[0]?.exif.capturedAt?.getTime() ?? 0;
    return dateB - dateA;
  });
---

<BaseLayout
  title="Rich King | Photo"
  description="Photography by Rich King — albums from Nicaragua, Panama, Costa Rica and the UK."
  page="photo"
  pageId="photo"
>
  <Header section="Photo" sectionHref="/photo" />

  <main id="wrapper">
    <div id="secondaryWrapper">
      {
        albums.map((album) => (
          <AlbumTile
            href={`/photo/${album.slug}`}
            title={album.title}
            count={album.photos.length}
            cover={modules[album.cover]!.default}
          />
        ))
      }
    </div>
  </main>
</BaseLayout>

<style is:global>
  html[id='photo'] #header {
    margin-bottom: 7vh;
  }

  html[id='photo'] #secondaryWrapper {
    padding: 0 0 8vh;
  }

  @media (max-width: 48rem) {
    html[id='photo'] #secondaryWrapper {
      padding: 0 0 12vw;
    }
  }
</style>
