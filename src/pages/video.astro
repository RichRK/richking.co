---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { videos } from '../data/videos';
---

<BaseLayout
  title="Rich King | Video"
  description="Short films and documentary work by Rich King, shot in Costa Rica, Nicaragua and Panama."
  page="video"
  pageId="video"
>
  <Header section="Video" sectionHref="/video" />

  <main id="wrapper">
    <div id="secondaryWrapper">
      {
        videos.map((video) => (
          <button type="button" class="film" data-video={video.id} data-youtube={video.youtubeId}>
            <span class="film__poster" style={`background-image: url('${video.poster}');`}>
              <span class="film__play" aria-hidden="true" />
              <span class="film__title">
                <h3>{video.title}</h3>
              </span>
              <span class="film__duration">
                <h5>{video.duration}</h5>
              </span>
            </span>
          </button>
        ))
      }
    </div>
  </main>

  {
    videos.map((video) => (
      <dialog class="film-dialog" id={`dialog-${video.id}`} aria-label={video.title}>
        <div class="film-dialog__inner">
          <h3>{video.title}</h3>
          <button type="button" class="film-dialog__close" data-close>
            <span class="visually-hidden">Close</span>
            <span aria-hidden="true">×</span>
          </button>

          <div class="film-dialog__frame">
            {/* src is set on open and cleared on close, so nothing from
                YouTube loads until the film is actually played. */}
            <iframe
              title={video.title}
              data-src={`https://www.youtube-nocookie.com/embed/${video.youtubeId}?rel=0&modestbranding=1&autoplay=1`}
              allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            />
          </div>

          <p>{video.description}</p>
          <h4>( {video.maxQuality} available )</h4>
        </div>
      </dialog>
    ))
  }
</BaseLayout>

<style>
  .film {
    display: inline-block;
    width: 28vw;
    margin: 1.5vw;
    padding: 0;
    border: 0;
    vertical-align: top;
  }

  .film__poster {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    background-size: cover;
    background-position: center;
    box-shadow: inset 0 0 0 100vmax rgba(0, 0, 0, 0.2);
    transition: box-shadow 0.3s ease;
  }

  .film:hover .film__poster,
  .film:focus-visible .film__poster {
    box-shadow: inset 0 0 0 100vmax rgba(0, 0, 0, 0.45);
  }

  /* The play triangle inside its circle, both drawn in CSS as before. */
  .film__play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 7vh;
    height: 7vh;
    border: 0.35vh solid var(--ink);
    border-radius: 50%;
    transition: transform 0.3s ease;
  }

  .film:hover .film__play {
    transform: translate(-50%, -50%) scale(1.1);
  }

  .film__play::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 54%;
    transform: translate(-50%, -50%);
    width: 0;
    height: 0;
    border-left: 1.8vh solid var(--ink);
    border-top: 1.1vh solid transparent;
    border-bottom: 1.1vh solid transparent;
  }

  .film__title {
    position: absolute;
    left: 0;
    right: 0;
    top: 2vh;
    text-align: center;
  }

  .film__title h3 {
    font-family: var(--font-display);
    font-size: 2.6vh;
    text-transform: none;
    text-shadow: 0 0 10px rgba(0, 0, 0, 0.7);
  }

  .film__duration {
    position: absolute;
    right: 1.5vh;
    bottom: 1.5vh;
  }

  .film__duration h5 {
    font-family: var(--font-ui);
    font-size: 1.4vh;
    color: var(--ink-muted);
    letter-spacing: 0.08em;
  }

  /* ---------------------------------------------------------------- dialog -- */

  /*
   * The original faked a modal with `:target` anchors and hid/showed it with
   * CSS, then drove six YouTube IFrame API players from ~270 lines of inline
   * script to pause on close. A real <dialog> does all of that natively.
   */
  .film-dialog {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: 90vw;
    max-height: 92vh;
    color: var(--ink);
  }

  .film-dialog::backdrop {
    background: rgba(0, 0, 0, 0.85);
  }

  .film-dialog__inner {
    position: relative;
    width: min(80vw, 1100px);
    background: var(--paper);
    border: 1px solid var(--hairline);
    padding: 3vh 3vh 4vh;
  }

  .film-dialog__inner h3 {
    font-family: var(--font-display);
    font-size: 3vh;
    text-transform: none;
    margin-bottom: 2vh;
  }

  .film-dialog__close {
    position: absolute;
    top: 2vh;
    right: 2.5vh;
    font-family: var(--font-ui);
    font-size: 3vh;
    line-height: 1;
    border: 0;
  }

  .film-dialog__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
  }

  .film-dialog__frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .film-dialog__inner p {
    font-family: var(--font-display);
    font-size: 2vh;
    line-height: 1.5;
    margin-top: 2.5vh;
  }

  .film-dialog__inner h4 {
    font-family: var(--font-ui);
    font-size: 1.4vh;
    color: var(--ink-muted);
    letter-spacing: 0.08em;
    margin-top: 1.5vh;
  }

  @media (max-width: 48rem) {
    .film {
      display: block;
      width: 90vw;
      margin: 0 auto 5vw;
    }

    .film__play {
      width: 56px;
      height: 56px;
      border-width: 3px;
    }

    .film__play::after {
      border-left-width: 15px;
      border-top-width: 9px;
      border-bottom-width: 9px;
    }

    .film__title h3 {
      font-size: 20px;
    }

    .film__duration h5 {
      font-size: 11px;
    }

    .film-dialog__inner {
      width: 92vw;
      padding: 16px 16px 24px;
    }

    .film-dialog__inner h3 {
      font-size: 20px;
    }

    .film-dialog__inner p {
      font-size: 14px;
    }
  }
</style>

<style is:global>
  html[id='video'] #secondaryWrapper {
    padding: 2vh 3vw 8vh;
    font-size: 0;
  }

  @media (max-width: 48rem) {
    html[id='video'] #secondaryWrapper {
      padding: 0 0 10vw;
    }
  }
</style>

<script>
  for (const trigger of document.querySelectorAll<HTMLButtonElement>('.film')) {
    trigger.addEventListener('click', () => {
      const dialog = document.getElementById(`dialog-${trigger.dataset.video}`);
      if (!(dialog instanceof HTMLDialogElement)) return;

      // Setting src here means no YouTube request is made — and no cookie set —
      // until someone actually opens a film.
      const iframe = dialog.querySelector('iframe');
      if (iframe && iframe.dataset.src) iframe.src = iframe.dataset.src;

      dialog.showModal();
    });
  }

  for (const dialog of document.querySelectorAll<HTMLDialogElement>('.film-dialog')) {
    const stop = () => {
      // Clearing src unloads the player, which is what stops playback. The
      // original needed the full IFrame API to achieve this.
      const iframe = dialog.querySelector('iframe');
      if (iframe) iframe.removeAttribute('src');
    };

    dialog.addEventListener('close', stop);
    dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());

    // Clicking the backdrop closes, matching the old anchor-based behaviour.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>
